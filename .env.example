# =================================================================
# Mivo Mobile Environment Variables Configuration
# =================================================================

# Backend Endpoints
# Options:
# - Physical Phone on same Wi-Fi: http://192.168.1.10:4000/api/v1
# - Android Emulator: http://10.0.2.2:4000/api/v1
# - Localhost / Web / iOS Simulator: http://localhost:4000/api/v1
# - Production: https://api.mivo.yourdomain.com/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_WS_URL=http://192.168.1.10:4000

# Application Metadata
EXPO_PUBLIC_APP_NAME=Mivo
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_SCHEME=mivo

# Supabase Storage & Assets (Optional direct access)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# AI Translation & Scribe Engine (Optional direct access)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
